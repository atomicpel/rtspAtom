<?xml version="1.0" encoding="utf-8"?>
<service>
  <id>rtspatom</id>
  <name>RTSP Atom</name>
  <description>RTSP Atom: панель управления видеотрансляцией</description>
  <executable>@NODE@</executable>
  <arguments>--disable-warning=ExperimentalWarning "@APP@\server\index.js"</arguments>
  <workingdirectory>@DATA@</workingdirectory>
  <env name="RTSPATOM_CONFIG" value="@CONFIG@"/>
  <env name="NODE_ENV" value="production"/>
  <depend>rtspatom-mediamtx</depend>
  <startmode>Automatic</startmode>
  <onfailure action="restart" delay="3 sec"/>
  <resetfailure>1 hour</resetfailure>
  <stoptimeout>10 sec</stoptimeout>
  <logpath>@LOGS@</logpath>
  <log mode="roll-by-size">
    <sizeThreshold>10240</sizeThreshold>
    <keepFiles>5</keepFiles>
  </log>
</service>
