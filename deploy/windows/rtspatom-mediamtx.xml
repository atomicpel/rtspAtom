<?xml version="1.0" encoding="utf-8"?>
<service>
  <id>rtspatom-mediamtx</id>
  <name>RTSP Atom MediaMTX</name>
  <description>RTSP Atom: видеосервер MediaMTX (приём видео с камер)</description>
  <executable>@MEDIAMTX@</executable>
  <arguments>"@YML@"</arguments>
  <workingdirectory>@DATA@</workingdirectory>
  <startmode>Automatic</startmode>
  <onfailure action="restart" delay="3 sec"/>
  <resetfailure>1 hour</resetfailure>
  <stoptimeout>10 sec</stoptimeout>
  <logpath>@LOGS@</logpath>
  <log mode="roll-by-size">
    <sizeThreshold>10240</sizeThreshold>
    <keepFiles>5</keepFiles>
  </log>
</service>
